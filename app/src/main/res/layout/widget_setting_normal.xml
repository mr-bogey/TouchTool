<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/listItemCardViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="?attr/minTouchTargetSize"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/icon"
            style="@style/Widget.Material3.ImageView.ListItem.LeadingIcon"
            android:layout_width="?attr/smallIconButtonSize"
            android:layout_height="?attr/smallIconButtonSize" />

        <LinearLayout
            android:id="@+id/box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="?attr/defaultPadding"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title"
                style="@style/Widget.Material3.TextView.ListItem.LabelText"
                android:layout_marginBottom="?attr/defaultOffset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- 标题下与说明上各让 defaultOffset(2dp)，合计 4dp：默认字体行距下两行几乎贴在一起 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/description"
                style="@style/Widget.Material3.TextView.ListItem.TrailingSupportingText"
                android:layout_marginTop="?attr/defaultOffset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/arrow"
            style="@style/Widget.Material3.ImageView.ListItem.LeadingIcon"
            android:layout_width="?attr/smallIconButtonSize"
            android:layout_height="?attr/smallIconButtonSize"
            app:srcCompat="@drawable/icon_keyboard_arrow_right" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
